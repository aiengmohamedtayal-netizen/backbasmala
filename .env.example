# Copy this file to .env (never commit .env to version control)
# Generate a secure SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=

# Allowed origins for CORS (comma-separated, without trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# JWT expiration period in days (optional, defaults to 7)
TOKEN_DAYS=7

# SQLite database file path (optional, defaults to careerly.db in project root)
# DATABASE_PATH=careerly.db
